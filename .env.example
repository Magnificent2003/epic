# ===== DashScope / Qwen =====
## DashScope API Key
DASHSCOPE_API_KEY=
## Default URL: cn-beijing
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
## Default Model: qwen-plus
DASHSCOPE_MODEL=qwen-3.7-max

# ===== OpenAI =====
## OpenAI API Key
OPENAI_API_KEY=
## Default URL
OPENAI_BASE_URL=https://api.openai.com/v1
## Default Model: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# ===== DeepSeek =====
## DeepSeek API Key
DEEPSEEK_API_KEY=
## Default URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
## Default Model: deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== AIAPI =====
## API Key
AIAPI_API_KEY=
## Default URL
AIAPI_BASE_URL=https://aiapi.world/v1

# ===== Default provider =====
LLM_PROVIDER=DashScope
AIAPI_MODEL=

# ===== Config =====
LLM_TIMEOUT_S=300
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=
